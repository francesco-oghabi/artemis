# OpenArtemis systemd unit (reference template).
#
# Install:
#   sudo cp deploy/artemis.service /etc/systemd/system/artemis.service
#   # edit User / paths / ARTEMIS_PG_DSN below to match your host
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now artemis
#
# One-click update: the server exits 75 ("restart me") after staging a new binary;
# RestartForceExitStatus=75 makes systemd relaunch it, and the next boot performs the
# atomic swap (see the selfupdate package). No start.sh needed — systemd is the supervisor.
#
# Data (PostgreSQL + the data dir) is separate from the binary, so updates never touch it.

[Unit]
Description=OpenArtemis — AI autonomous penetration testing platform
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=artemis
Group=artemis

# The binary lives in a WRITABLE dir so one-click update can swap it in place
# (it writes artemis.new / artemis.old alongside the running binary).
WorkingDirectory=/opt/artemis
ExecStart=/opt/artemis/artemis -addr :8787 -data /opt/artemis/data

Environment=ARTEMIS_PG_DSN=postgres://artemis:artemis@127.0.0.1:5432/artemis?sslmode=disable
# Optional: route GitHub update requests through an egress proxy if GitHub is blocked.
# Environment=ARTEMIS_UPDATE_PROXY=http://127.0.0.1:7890

# Restart on crashes AND on the exit-75 "restart requested" code (one-click update/rollback).
# A clean stop (systemctl stop → SIGTERM → exit 0) does NOT restart.
Restart=on-failure
RestartForceExitStatus=75
RestartSec=2

# Give in-flight tasks a moment to wind down on stop/restart.
TimeoutStopSec=15
# Let the process write its own binary + sibling files during an update.
ReadWritePaths=/opt/artemis

[Install]
WantedBy=multi-user.target
